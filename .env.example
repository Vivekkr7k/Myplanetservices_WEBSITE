# TEMPLATE ONLY — this file IS tracked by git.
# Put real values in .env.local (gitignored). Never here.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender. Fixed, and must stay on the verified myplanetservices.com domain.
# The visitor's confirmation is addressed to whatever email they submit — that
# recipient is dynamic and needs no configuration here.
MAIL_FROM="My Planet Services <vivek@myplanetservices.com>"

# Optional. Where the internal lead notification is delivered.
# Defaults to vivek@myplanetservices.com when unset.
MAIL_TO=vivek@myplanetservices.com

# Google Sheet lead capture (optional — leads still email if unset).
# SHEETS_WEBHOOK_URL is the /exec URL from deploying google-apps-script/Code.gs
# as a web app. The token must match SHARED_TOKEN inside that script.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
SHEETS_WEBHOOK_TOKEN=replace_with_a_long_random_string
